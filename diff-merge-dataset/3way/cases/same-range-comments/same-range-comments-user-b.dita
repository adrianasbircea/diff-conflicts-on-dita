          <tbody>
            <row id="row-sec">
              <entry colname="c1" id="e-sec-name">Transport security</entry>
              <?oxy_comment_start author="Dan Ionescu" timestamp="20260903T131300+0300" comment="Should this say Active since 4.0?" id="cmt-b-cell"?><?oxy_comment_start author="Ana Popescu" timestamp="20260903T131400+0300" comment="Yes, and add the same column to the endpoints table." parentID="cmt-b-cell" mid="1"?><entry
                colname="c2" id="e-sec-status">Active</entry><?oxy_comment_end mid="1"?><?oxy_comment_end?>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
  </body>
