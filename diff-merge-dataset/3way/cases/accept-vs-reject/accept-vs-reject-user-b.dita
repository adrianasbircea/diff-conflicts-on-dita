<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="cf-21-accept-vs-reject" xml:lang="en-us">
  <title id="topic-title">Accept Against Reject</title>
  <shortdesc id="shortdesc">Unlike every other file in this dataset, this base already carries
    review markup. A accepts it, B rejects it.</shortdesc>
  <body>
    <section id="sec-overview">
      <title id="title-overview">Overview</title>
      <p id="p-intro">The Authentication Service validates user credentials and issues signed access
        tokens. It runs as a stateless component and can be scaled horizontally behind a load
        balancer.</p>
      <note id="note-warn" type="warning">Never commit the signing key to the repository.</note>
    </section>
    <section id="sec-config">
      <title id="title-config">Configuring the service</title>
      <?oxy_comment_start author="Dan Ionescu" timestamp="20260901T090200+0300" comment="Describe the rolling restart procedure here." id="cmt-base-config"?><?oxy_comment_start author="Ana Popescu" timestamp="20260901T090300+0300" comment="Agreed, I will add it once the procedure is approved." parentID="cmt-base-config" mid="1"?><p
        id="p-config-lead">The configuration file is read once, at startup. Restart every service
        instance after every change.</p><?oxy_comment_end mid="1"?><?oxy_comment_end?>
      <ol id="ol-steps">
        <li id="li-step-1">Stop the running service instance.</li>
        <li id="li-step-2">Start the service and check the health endpoint.</li>
      </ol>
      <table id="table-limits" frame="all" colsep="0">
        <title id="title-table-limits">Limits</title>
        <tgroup cols="2">
          <colspec colname="l1" colnum="1" colwidth="2*"/>
          <colspec colname="l2" colnum="2" colwidth="1*"/>
          <tbody>
            <row id="row-lim-ttl">
              <entry colname="l1" id="e-lim-ttl-name">Token TTL</entry>
              <entry colname="l2" id="e-lim-ttl-def">3600</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section id="sec-trouble">
      <title id="title-trouble">Troubleshooting</title>
      <p id="p-trouble-lead">Check the service log first.</p>
    </section>
  </body>
</topic>
